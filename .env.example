APP_NAME=Meridian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The nginx "web" service publishes the app on host port 8080.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# The app connects to the Docker Compose "postgres" SERVICE (by name), never 127.0.0.1.
# sqlite is deliberately never used: Row-Level Security (the tenant-isolation backstop
# introduced in Increment A) cannot be validated on sqlite. See docs/testing-strategy.md §2.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ── Redis / Valkey ──────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mailpit (dev email capture) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@meridian.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
# Compose gains a "minio" service in the increment that first stores files; keys shown for parity.
AWS_ACCESS_KEY_ID=meridian
AWS_SECRET_ACCESS_KEY=secretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=meridian
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
