APP_NAME=Meridian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The nginx "web" service publishes the app on host port 8080.
APP_URL=http://localhost:8080

# What Settings → About reports (I5, PRD Feature #10). Set by the deployment pipeline; left blank locally,
# where the panel shows "dev" and dates itself from the Vite manifest instead. NOT the same thing as the
# client bundle's __APP_VERSION__ (vite.config.ts), which identifies the assets, not the deployment.
APP_VERSION=
APP_COMMIT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# The app connects to the Docker Compose "postgres" SERVICE (by name), never 127.0.0.1.
# sqlite is deliberately never used: Row-Level Security (the tenant-isolation backstop
# introduced in Increment A) cannot be validated on sqlite. See docs/testing-strategy.md §2.
#
# The app connects as `meridian_app` — a NON-superuser, NOBYPASSRLS role that OWNS the tables
# (ADR-0002 §D2). RLS only bites for a non-superuser, and FORCE ROW LEVEL SECURITY is what makes
# even the owning role obey the tenant policies. The role is created by docker/postgres/init.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian_app
DB_PASSWORD=secret

# Elevated connection reserved for operations that must bypass RLS (schema owner / seeding the
# platform-global `tenant_id IS NULL` rows from Increment B onward). Not exercised in Increment A.
DB_PRIVILEGED_USERNAME=meridian
DB_PRIVILEGED_PASSWORD=secret

# Pre-auth connection (Increment B1): the non-superuser `meridian_auth` role, granted access to the
# `users` identity table ONLY, used by RlsAwareUserProvider to resolve/update a user during
# login/password-reset before any tenant context exists (when `users` RLS would fail closed).
DB_AUTH_USERNAME=meridian_auth
DB_AUTH_PASSWORD=secret

# Elevated super-admin connection (Increment B2c): the non-superuser `meridian_superadmin` role, used
# ONLY by App\Services\Admin\SuperAdminService for cross-tenant reads. It is STILL subject to RLS and
# reaches rows only via the `superadmin_bypass` carve-out policy (gated on app.is_superadmin_context).
DB_SUPERADMIN_USERNAME=meridian_superadmin
DB_SUPERADMIN_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Queue (ADR-0007) ────────────────────────────────────────────────────────
# The `database` driver on the existing Postgres, drained by `queue:work` (the worker/scheduler
# compose services). `deferred`/`background`/`failover` were REMOVED from config/queue.php per §D11 —
# setting QUEUE_CONNECTION to any of them now throws at boot.
QUEUE_CONNECTION=database
# INVARIANT (§D7): must stay strictly above TenantAwareJob::$timeout (60).
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_RETENTION_DAYS=14

# Per-tenant fairness (§D9). Ceilings are UNVALIDATED planning assumptions — see the banner in
# config/queue-fairness.php before changing them. QUEUE_FAIRNESS_ENABLED=false is the escape hatch.
# QUEUE_FAIRNESS_ENABLED=true
# QUEUE_FAIRNESS_SUBMISSIONS=120
# QUEUE_FAIRNESS_RETRY_WINDOW_HOURS=6

CACHE_STORE=database
# CACHE_PREFIX=

# ── Redis / Valkey ──────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mailpit (dev email capture) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@meridian.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
# Compose gains a "minio" service in the increment that first stores files; keys shown for parity.
AWS_ACCESS_KEY_ID=meridian
AWS_SECRET_ACCESS_KEY=secretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=meridian
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# ── First-party Google sign-in (J3c2 — ADR-0017) ────────────────────────────
# "Continue with Google" on /login and /register. ⚠️ NOT the Google Sheets CONNECTOR below, which is a
# DIFFERENT OAuth client with a different consent screen and a different blast radius: this one reads an
# identity once and throws the token away; that one holds a durable credential and acts as the tenant
# inside the tenant's own spreadsheet. Two Google blocks, kept apart by name on purpose — ADR-0009 §D9
# records that conflating a sign-in block with an unrelated one of the same vendor name is a mistake this
# file has made before.
#
# Leave both empty and the feature is simply absent: GoogleSignInGate hides the button and 404s the
# routes, which is a SUPPORTED state rather than a broken one. Every behaviour behind them is exercised in
# tests against a fake, so the build never waited on these values.
#
# The redirect URI to register in the Google Cloud console is the CENTRAL host exactly:
#   https://<CENTRAL_DOMAIN>/auth/google/callback    (locally: http://localhost:8080/auth/google/callback)
# ONE URI serves every workspace — Google rejects wildcard redirect URIs for an identity client exactly as
# for an API one — which is why the callback lands centrally and carries the workspace in a signed `state`
# instead of a session. It is DERIVED from APP_URL rather than configured separately, because Google
# matches it byte for byte between the authorize step and the token exchange and a third variable is a
# third chance to get that wrong in production only.
#
# Two console settings this app depends on and cannot detect the absence of:
#   • the OAuth consent screen must publish exactly the `openid`, `email` and `profile` scopes. Nothing
#     else is requested: a sign-in asking for Drive scopes would be a connector, and would fall under
#     ADR-0009's token-custody rules in full.
#   • the "External" user type, unless every expected user is inside your own Workspace org.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The `state` token is signed with a key DERIVED from APP_KEY by default, domain-separated so a
# connector state can never validate here and vice versa. Set this only to rotate the sign-in token family
# independently of APP_KEY; rotating it invalidates every consent screen currently open, which is a
# ~10-minute window rather than a session-length one.
# GOOGLE_SIGNIN_STATE_KEY=

# ── Native connectors (H15a — ADR-0009) ─────────────────────────────────────
# The platform-wide OAuth app credentials for each native connector. These are OURS, not a tenant's, and
# never live in the database (ADR-0009 §D9). A provider with no credentials configured simply cannot be
# connected — the routes still exist, the consent screen refuses.
#
# The redirect URI registered in the provider's app console must be the CENTRAL host exactly:
#   https://<CENTRAL_DOMAIN>/oauth/slack/callback     (locally: http://localhost:8080/oauth/slack/callback)
# One URI serves every tenant — providers reject wildcard subdomains, which is why the callback lands
# centrally and carries tenant identity in a signed `state` instead of a session.
#
# ⚠ WHERE EACH PIECE OF THAT URI COMES FROM (H16b) — the port is the part that used to go missing:
#   scheme  CONNECTOR_TENANT_URL_SCHEME (below)
#   host    CENTRAL_DOMAIN
#   port    APP_URL's port, and ONLY when APP_URL's host is CENTRAL_DOMAIN
# CENTRAL_DOMAIN cannot hold the port itself: it also feeds `tenancy.central_domains`, and `Route::domain()`
# matches `Request::getHost()`, which strips ports — so `localhost:8080` there silently deletes the
# super-admin console route, this callback's own route, the platform-host guard and tenant identification.
# Keep APP_URL pointed at the central origin (`http://localhost:8080`, not a tenant subdomain), and the
# console entry above matches by construction.
SLACK_CONNECTOR_CLIENT_ID=
SLACK_CONNECTOR_CLIENT_SECRET=

# Google Sheets (H16a). Redirect URI: https://<CENTRAL_DOMAIN>/oauth/google_sheets/callback — registered in
# the Google Cloud console under the SAME OAuth client as these credentials. Two console settings this app
# depends on and cannot detect the absence of:
#   • the Google Sheets API and the Google Drive API must both be ENABLED on the project;
#   • the consent screen must publish exactly the `drive.file` scope. It is Google's own "Recommended,
#     Non-sensitive" scope for Sheets, so it needs no verification review — adding `spreadsheets` would.
# Per-file access is the whole point: we can only touch spreadsheets this app created or the tenant picked,
# so a mis-typed spreadsheet id fails as "we cannot reach that file", never as "here is someone else's data".
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=

# Airtable (H16c). Redirect URI: https://<CENTRAL_DOMAIN>/oauth/airtable/callback — registered at
# https://airtable.com/create/oauth under the SAME integration as these credentials. Three console settings
# this app depends on and cannot detect the absence of:
#   • exactly two scopes: `schema.bases:read` and `data.records:write`. Do NOT add `schema.bases:write` — the
#     connector reads table names and adds records, and never alters a tenant's base structure (ADR-0009 §D8).
#   • the redirect URI must match byte for byte, INCLUDING THE PORT. Airtable permits `http://localhost` for
#     development; every other host must be https.
#   • the integration must be left in its default state — unlike Google there is no verification review and
#     no 7-day token expiry, so there is no publishing_status twin of GOOGLE_CONNECTOR_PUBLISHING_STATUS.
# The client secret is shown ONCE at generation; Airtable stores only a hash and cannot re-display it.
AIRTABLE_CONNECTOR_CLIENT_ID=
AIRTABLE_CONNECTOR_CLIENT_SECRET=

# Scheme for every tenant-facing URL the connector framework builds — the registered redirect URI and the
# post-consent return. Defaults to `https`; SET IT TO `http` LOCALLY or the OAuth flow sends Google a
# redirect URI that cannot match what you registered, and lands the browser on a scheme nothing serves.
CONNECTOR_TENANT_URL_SCHEME=https

# The signing key for that `state` token. Left blank it is derived from APP_KEY with domain separation
# (the guest share/resume-token convention); set it to rotate connector state tokens independently.
CONNECTOR_STATE_KEY=

# ⚠ Every stored connector token is encrypted under APP_KEY. Rotating APP_KEY WITHOUT populating
# APP_PREVIOUS_KEYS (comma-separated, config/app.php reads it) makes every existing grant undecryptable —
# and it surfaces as mass delivery failure, not a boot error. See ADR-0009 §D9.
APP_PREVIOUS_KEYS=
