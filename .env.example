APP_NAME=Meridian
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The nginx "web" service publishes the app on host port 8080.
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# The app connects to the Docker Compose "postgres" SERVICE (by name), never 127.0.0.1.
# sqlite is deliberately never used: Row-Level Security (the tenant-isolation backstop
# introduced in Increment A) cannot be validated on sqlite. See docs/testing-strategy.md §2.
#
# The app connects as `meridian_app` — a NON-superuser, NOBYPASSRLS role that OWNS the tables
# (ADR-0002 §D2). RLS only bites for a non-superuser, and FORCE ROW LEVEL SECURITY is what makes
# even the owning role obey the tenant policies. The role is created by docker/postgres/init.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=meridian
DB_USERNAME=meridian_app
DB_PASSWORD=secret

# Elevated connection reserved for operations that must bypass RLS (schema owner / seeding the
# platform-global `tenant_id IS NULL` rows from Increment B onward). Not exercised in Increment A.
DB_PRIVILEGED_USERNAME=meridian
DB_PRIVILEGED_PASSWORD=secret

# Pre-auth connection (Increment B1): the non-superuser `meridian_auth` role, granted access to the
# `users` identity table ONLY, used by RlsAwareUserProvider to resolve/update a user during
# login/password-reset before any tenant context exists (when `users` RLS would fail closed).
DB_AUTH_USERNAME=meridian_auth
DB_AUTH_PASSWORD=secret

# Elevated super-admin connection (Increment B2c): the non-superuser `meridian_superadmin` role, used
# ONLY by App\Services\Admin\SuperAdminService for cross-tenant reads. It is STILL subject to RLS and
# reaches rows only via the `superadmin_bypass` carve-out policy (gated on app.is_superadmin_context).
DB_SUPERADMIN_USERNAME=meridian_superadmin
DB_SUPERADMIN_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Queue (ADR-0007) ────────────────────────────────────────────────────────
# The `database` driver on the existing Postgres, drained by `queue:work` (the worker/scheduler
# compose services). `deferred`/`background`/`failover` were REMOVED from config/queue.php per §D11 —
# setting QUEUE_CONNECTION to any of them now throws at boot.
QUEUE_CONNECTION=database
# INVARIANT (§D7): must stay strictly above TenantAwareJob::$timeout (60).
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_RETENTION_DAYS=14

# Per-tenant fairness (§D9). Ceilings are UNVALIDATED planning assumptions — see the banner in
# config/queue-fairness.php before changing them. QUEUE_FAIRNESS_ENABLED=false is the escape hatch.
# QUEUE_FAIRNESS_ENABLED=true
# QUEUE_FAIRNESS_SUBMISSIONS=120
# QUEUE_FAIRNESS_RETRY_WINDOW_HOURS=6

CACHE_STORE=database
# CACHE_PREFIX=

# ── Redis / Valkey ──────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mailpit (dev email capture) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@meridian.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
# Compose gains a "minio" service in the increment that first stores files; keys shown for parity.
AWS_ACCESS_KEY_ID=meridian
AWS_SECRET_ACCESS_KEY=secretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=meridian
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
