# Supabase's names, kept by supabase-js. Since Meridian's bhw-p3-identity nothing reaches Supabase: the
# URL is only the prefix REST calls carry (lib/db/data-plane.ts sends them to SUPABASE_REST_URL), and the
# keys are minted for this app's PostgREST by db/mint-jwt.mjs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543) connection string for serverless server-side access
DATABASE_URL=

# On the testing box, USAGE_EVENTS_IP_SALT, the four AI keys and CRON_SECRET come from GitHub repository
# secrets named BHW_<NAME>, written by ops/write-settings.ps1 at each deploy (Meridian's D199).

# Usage-event IP hashing
USAGE_EVENTS_IP_SALT=

# AI providers (Phase 2 — free tiers only)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Precompute cron auth (Phase 2) — Vercel automatically sends this as a Bearer token to
# vercel.json's scheduled routes once it's set as a project env var.
CRON_SECRET=

# Served under a path prefix: `/bhw-connect` and `https://staging.pitahc.gov.ph/bhw-connect` on
# Meridian's testing box; empty everywhere else (lib/base-path.ts, lib/site-url.ts).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=

# The data plane (lib/db/data-plane.ts). SUPABASE_REST_URL, set on the testing box, sends
# supabase-js's REST calls to PostgREST instead of ${NEXT_PUBLIC_SUPABASE_URL}/rest/v1.
# BHW_DATA_SOURCE=none is for CI's build only: no database, every REST call answered at once.
SUPABASE_REST_URL=
BHW_DATA_SOURCE=

# Who is signed in (lib/db/meridian-identity.ts): Meridian's address, as this server reaches it.
# https://staging.pitahc.gov.ph on the testing box, whose hosts file sends that name to 127.0.0.1.
# Empty: no admin can sign in. BHW_AUTH_MODE=stub signs in a fixed local admin instead (development only;
# a production server ignores it): 00000000-0000-4000-8000-000000000001, which needs an admin_users row.
MERIDIAN_INTERNAL_URL=
BHW_AUTH_MODE=

# Feedback screenshots (lib/storage/screenshots.ts): C:\meridian\bhw\storage on the box; empty means
# ./.local-storage.
BHW_STORAGE_DIR=

# Database tooling (db/): the migration runner, its tests, the seed generator, the key minter.
BHW_DATABASE_URL=
BHW_TEST_DATABASE_URL=
BHW_SEED_SOURCE_URL=
BHW_JWT_SECRET=
# Optional, the box only: a full path to pg_dump.exe when the newest PostgreSQL install under
# Program Files is not the one to use (ops/pg-tools.ps1 Resolve-PgDump).
BHW_PG_DUMP=

# The local stack (docker compose up -d) — throw-away values for this machine only:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:3001
#   SUPABASE_REST_URL=http://127.0.0.1:3001
#   BHW_DATABASE_URL=postgres://bhw_app:bhw-local@127.0.0.1:5442/bhw_connect
#   BHW_TEST_DATABASE_URL=postgres://postgres:bhw-local@127.0.0.1:5442/bhw_connect
#   BHW_JWT_SECRET=bhw-local-jwt-secret-for-this-machine-only
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<output of: node db/mint-jwt.mjs --role=anon>
#   SUPABASE_SERVICE_ROLE_KEY=<output of: node db/mint-jwt.mjs --role=service_role>
