# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543) connection string for serverless server-side access
DATABASE_URL=

# Usage-event IP hashing
USAGE_EVENTS_IP_SALT=

# AI providers (Phase 2 — free tiers only)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Precompute cron auth (Phase 2) — Vercel automatically sends this as a Bearer token to
# vercel.json's scheduled routes once it's set as a project env var.
CRON_SECRET=

# Served under a path prefix: `/bhw-connect` and `https://staging.pitahc.gov.ph/bhw-connect` on
# Meridian's testing box; empty everywhere else (lib/base-path.ts, lib/site-url.ts).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=

# The data plane (lib/db/data-plane.ts). SUPABASE_REST_URL, set on the testing box, sends
# supabase-js's REST calls to PostgREST instead of ${NEXT_PUBLIC_SUPABASE_URL}/rest/v1.
# BHW_DATA_SOURCE=none is for CI's build only: no database, every REST call answered at once.
SUPABASE_REST_URL=
BHW_DATA_SOURCE=

# Database tooling (db/): the migration runner, its tests, the seed generator, the key minter.
BHW_DATABASE_URL=
BHW_TEST_DATABASE_URL=
BHW_SEED_SOURCE_URL=
BHW_JWT_SECRET=

# The local stack (docker compose up -d) — throw-away values for this machine only:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:3001
#   SUPABASE_REST_URL=http://127.0.0.1:3001
#   BHW_DATABASE_URL=postgres://bhw_app:bhw-local@127.0.0.1:5442/bhw_connect
#   BHW_TEST_DATABASE_URL=postgres://postgres:bhw-local@127.0.0.1:5442/bhw_connect
#   BHW_JWT_SECRET=bhw-local-jwt-secret-for-this-machine-only
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<output of: node db/mint-jwt.mjs --role=anon>
#   SUPABASE_SERVICE_ROLE_KEY=<output of: node db/mint-jwt.mjs --role=service_role>
