{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.0",
        "dompdf/dompdf": "^3.1.6",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/fortify": "^1.36",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "onelogin/php-saml": "^4.3",
        "openspout/openspout": "^4",
        "spatie/laravel-permission": "^8.3",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.30",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.7",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": "@php vendor/bin/pint --test",
        "lint:fix": "@php vendor/bin/pint",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "controller-gate": "@php scripts/controller-gate.php",
        "migration-lint": "@php scripts/migration-lint.php",
        "job-payload-lint": "@php scripts/job-payload-lint.php",
        "constraint-boundary-lint": "@php scripts/constraint-boundary-lint.php",
        "component-import-lint": "@php scripts/component-import-lint.php",
        "mail-attribute-lint": "@php scripts/mail-attribute-lint.php",
        "tracker-lint": "@php scripts/tracker-lint.php",
        "tracker-lint-controls": "@php scripts/tracker-lint-controls.php",
        "tracker-surgery": "@php scripts/tracker-surgery.php",
        "citation-liveness-lint": "@php scripts/citation-liveness-lint.php",
        "preflight": "@php scripts/preflight.php",
        "gate-baselines": "@php scripts/gate-baselines.php",
        "mutate": "@php scripts/mutate.php",
        "state": "@php scripts/state.php",
        "next": "@php scripts/next.php",
        "quality": [
            "@lint",
            "@analyse",
            "@controller-gate",
            "@migration-lint",
            "@job-payload-lint",
            "@constraint-boundary-lint",
            "@component-import-lint",
            "@mail-attribute-lint",
            "@tracker-lint",
            "@tracker-lint-controls",
            "@citation-liveness-lint"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "hooks:install": "@php -r \"passthru('git config core.hooksPath .githooks'); echo 'pre-push guard installed', PHP_EOL;\"",
        "loop": "@php scripts/loop.php"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
