{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "dev_formbuilder_app",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "type-check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.sw.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "ds:install": "npm --prefix packages/design-system install",
        "ds:tokens": "npm --prefix packages/design-system run build:tokens",
        "ds:storybook": "npm --prefix packages/design-system run storybook",
        "ds:storybook:build": "npm --prefix packages/design-system run build-storybook",
        "ds:test": "npm --prefix packages/design-system run test-storybook",
        "e2e": "playwright test",
        "e2e:install": "playwright install --with-deps chromium"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.1",
        "@playwright/test": "^1.49.1",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.6",
        "concurrently": "^9.0.1",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.10.6",
        "laravel-vite-plugin": "^3.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.6",
        "workbox-cacheable-response": "^7.4.1",
        "workbox-core": "^7.4.1",
        "workbox-expiration": "^7.4.1",
        "workbox-precaching": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.0",
        "@meridian/design-system": "file:packages/design-system",
        "dexie": "^4.4.4",
        "leaflet": "^1.9.4",
        "vue": "^3.5.39"
    },
    "overrides": {
        "postcss": "^8.5.23"
    }
}
