{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "dev_formbuilder_app",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "ds:install": "npm --prefix packages/design-system install",
        "ds:tokens": "npm --prefix packages/design-system run build:tokens",
        "ds:storybook:build": "npm --prefix packages/design-system run build-storybook",
        "ds:test": "npm --prefix packages/design-system run test-storybook",
        "e2e": "playwright test",
        "e2e:install": "playwright install --with-deps chromium"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.1",
        "@playwright/test": "^1.49.1",
        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.6"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.0",
        "@meridian/design-system": "file:packages/design-system",
        "vue": "^3.5.39"
    }
}
