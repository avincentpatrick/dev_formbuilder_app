[
  {
    "name": "matrix all cells answered passes",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a", "b"], "columns": ["q1", "q2"], "cells": ["poor", "ok", "good"] } } ] },
    "answers": { "svc": { "a": { "q1": "ok", "q2": "good" }, "b": { "q1": "poor", "q2": "ok" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [],
      "effective_answers": { "svc": { "a": { "q1": "ok", "q2": "good" }, "b": { "q1": "poor", "q2": "ok" } } }
    }
  },
  {
    "name": "matrix cell not in cells fails",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a"], "columns": ["q1"], "cells": ["poor", "ok"] } } ] },
    "answers": { "svc": { "a": { "q1": "zzz" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.a.q1", "rule": "choice_not_in_options" } ],
      "effective_answers": { "svc": { "a": { "q1": "zzz" } } }
    }
  },
  {
    "name": "matrix optional partial fill passes",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a", "b"], "columns": ["q1", "q2"], "cells": ["ok"] } } ] },
    "answers": { "svc": { "a": { "q1": "ok" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [],
      "effective_answers": { "svc": { "a": { "q1": "ok" } } }
    }
  },
  {
    "name": "matrix required demands every cell",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "is_required": "required", "grid": { "rows": ["a"], "columns": ["q1", "q2"], "cells": ["ok"] } } ] },
    "answers": { "svc": { "a": { "q1": "ok" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.a.q2", "rule": "field_required" } ],
      "effective_answers": { "svc": { "a": { "q1": "ok" } } }
    }
  },
  {
    "name": "matrix required all missing errors every cell",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "is_required": "required", "grid": { "rows": ["a", "b"], "columns": ["q1"], "cells": ["ok"] } } ] },
    "answers": {},
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [
        { "field": "svc.a.q1", "rule": "field_required" },
        { "field": "svc.b.q1", "rule": "field_required" }
      ],
      "effective_answers": {}
    }
  },
  {
    "name": "matrix hidden is not checked",
    "grammar_version": "2.0",
    "schema": { "fields": [
      { "key": "gate", "field_type": "short_text" },
      { "key": "svc", "field_type": "matrix", "is_required": "required", "relevant": "${gate} = 'go'", "grid": { "rows": ["a"], "columns": ["q1"], "cells": ["ok"] } }
    ] },
    "answers": { "gate": "stop", "svc": { "a": { "q1": "bad" } } },
    "expected": {
      "relevance": { "fields": { "gate": true, "svc": false } },
      "errors": [],
      "effective_answers": { "gate": "stop" }
    }
  },
  {
    "name": "matrix empty object is dropped when optional",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a"], "columns": ["q1"], "cells": ["ok"] } } ] },
    "answers": { "svc": {} },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [],
      "effective_answers": {}
    }
  },
  {
    "name": "matrix row with only empty cells is dropped",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a", "b"], "columns": ["q1", "q2"], "cells": ["ok"] } } ] },
    "answers": { "svc": { "a": { "q1": "ok" }, "b": { "q1": "", "q2": "" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [],
      "effective_answers": { "svc": { "a": { "q1": "ok" } } }
    }
  },
  {
    "name": "matrix typed columns keep their typed values",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a"], "columns": ["n", "w", "t", "d", "m"], "cells": ["ok"], "column_specs": { "n": { "type": "integer" }, "w": { "type": "decimal" }, "t": { "type": "short_text" }, "d": { "type": "date" }, "m": { "type": "multi_select", "options": ["x", "y", "z"] } } } } ] },
    "answers": { "svc": { "a": { "n": 4, "w": 2.5, "t": "hello", "d": "2026-10-22", "m": ["x", "z"] } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [],
      "effective_answers": { "svc": { "a": { "n": 4, "w": 2.5, "t": "hello", "d": "2026-10-22", "m": ["x", "z"] } } }
    }
  },
  {
    "name": "matrix multi column refuses a choice outside its own list",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a"], "columns": ["m"], "cells": ["ok"], "column_specs": { "m": { "type": "multi_select", "options": ["x", "y"] } } } } ] },
    "answers": { "svc": { "a": { "m": ["x", "ok"] } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.a.m", "rule": "choice_not_in_options" } ],
      "effective_answers": { "svc": { "a": { "m": ["x", "ok"] } } }
    }
  },
  {
    "name": "matrix column own choices replace the shared cell choices",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a"], "columns": ["c1", "c2"], "cells": ["poor", "ok"], "column_specs": { "c1": { "type": "single_select", "options": ["yes", "no"] } } } } ] },
    "answers": { "svc": { "a": { "c1": "yes", "c2": "yes" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.a.c2", "rule": "choice_not_in_options" } ],
      "effective_answers": { "svc": { "a": { "c1": "yes", "c2": "yes" } } }
    }
  },
  {
    "name": "matrix whole-number column refuses a fraction",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a"], "columns": ["n"], "column_specs": { "n": { "type": "integer" } } } } ] },
    "answers": { "svc": { "a": { "n": 2.5 } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.a.n", "rule": "not_a_whole_number" } ],
      "effective_answers": { "svc": { "a": { "n": 2.5 } } }
    }
  },
  {
    "name": "matrix required column demands its cell in every row",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "grid": { "rows": ["a", "b"], "columns": ["q1", "q2"], "cells": ["ok"], "column_specs": { "q1": { "required": true } } } } ] },
    "answers": { "svc": { "a": { "q1": "ok" } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.b.q1", "rule": "field_required" } ],
      "effective_answers": { "svc": { "a": { "q1": "ok" } } }
    }
  },
  {
    "name": "matrix multi column with nothing ticked is unanswered",
    "grammar_version": "2.0",
    "schema": { "fields": [ { "key": "svc", "field_type": "matrix", "is_required": "required", "grid": { "rows": ["a"], "columns": ["m"], "column_specs": { "m": { "type": "multi_select", "options": ["x"] } } } } ] },
    "answers": { "svc": { "a": { "m": [] } } },
    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [ { "field": "svc.a.m", "rule": "field_required" } ],
      "effective_answers": {}
    }
  }
]