    "expected": {
      "relevance": { "fields": { "svc": true } },
      "errors": [],
      "effective_answers": { "svc": { "a": { "q1": "ok", "q2": "good" }, "b": { "q1": "poor", "q2": "ok" } } }
    }
  },
  {
    "name": "matrix cell not in cells fails",
